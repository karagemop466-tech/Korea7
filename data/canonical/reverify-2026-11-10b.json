  "rules": [
    {
      "source": "S164",
      "page": "SF.gov plumbing/mechanical permit",
      "what_it_says": "“You need a permit before cutting into or replacing pipes, particularly pipes that will be covered by a wall or buried in the ground.” C-4, C-16, C-20, C-36, C-54, B and A license holders may apply; scope may be limited by licence type; inspection is required before pipes are covered.",
      "bearing_on_this_job": "The trip-lever assembly sits behind a wall, so any work that cuts or replaces its piping falls inside this sentence.",
      "read_note": "Quoted text matches the page as read 2026-11-10.",
      "url": "https://www.sf.gov/apply-plumbing-and-mechanical-permit"
    },
    {
      "source": "S165",
      "page": "SF.gov — which projects need a permit",
      "what_it_says": "Exempt list includes “Minor repairs to existing interior plaster or wallboard, unless they are required for fire protection.”",
      "bearing_on_this_job": "Bears on patching the ceiling only; it says nothing about the concealed plumbing.",
      "read_note": "Quoted text matches the page as read 2026-11-10.",
      "url": "https://www.sf.gov/information--check-if-your-construction-project-needs-permit"
    },
    {
      "source": "S166",
      "page": "SF Building Code §104.0 (Permits)",
      "what_it_says": "The code-library page for §104.0 was reachable and is the section sf.gov cites for permit procedure.",
      "bearing_on_this_job": "Procedural reference only.",
      "read_note": "Page read; §104.2 wording itself was taken from the City PDF (S167), not from this page.",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_building/0-0-0-85830"
    },
    {
      "source": "S167",
      "page": "2025 SF Plumbing Code PDF — §104.2",
      "what_it_says": "“104.2 Exempt Work. A permit shall not be required for the following:” followed by the nine listed items (leak repair, unstopping, faucets/angle stops/hose bibbs/roof drains, toilet replacement, furnace filters, piping removal after approved disconnection, display set-up, water conservation devices, State and Federal buildings).",
      "bearing_on_this_job": "None of the nine items names a trip lever, overflow plate or waste-and-overflow assembly.",
      "read_note": "The nine items on the Code exemptions page were compared word for word with pages 4–5 of this PDF: they match.",
      "url": "https://media.api.sf.gov/documents/2025_SF_Plumbing_Code.pdf"
    },
    {
      "source": "S162",
      "page": "Business & Professions Code §7048",
      "what_it_says": "The licensing exemption applies only where the aggregate contract price is under $1,000, the work is casual/minor/inconsequential, AND the work does not require a building permit. It does not apply where the person advertises as a contractor or employs others.",
      "bearing_on_this_job": "All three quoted prices ($135, $550, $614) are below $1,000, but the price test is only one of the conditions and this site does not determine the others.",
      "read_note": "Full subdivision text read 2026-11-10.",
      "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=7048.&lawCode=BPC"
    },
    {
      "source": "S163",
      "page": "Business & Professions Code §7059",
      "what_it_says": "A specialty contractor may take and execute a contract using two or more crafts or trades where the other work is “incidental and supplemental” to the craft for which the contractor is licensed.",
      "bearing_on_this_job": "Relevant to a C-36 plumber patching drywall as an incidental part of the repair; whether a ceiling opening and its restoration is “incidental and supplemental” has not been determined here.",
      "read_note": "Text read 2026-11-10; no determination made.",
      "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?sectionNum=7059.&lawCode=BPC"
    },
    {
      "source": "S168",
      "page": "California Civil Code §1954",
      "what_it_says": "A landlord may enter to make necessary or agreed repairs; except in an emergency, entry is during normal business hours with reasonable written notice stating date, approximate time and purpose; 24 hours is presumed reasonable.",
      "bearing_on_this_job": "Bears on giving the tenant notice before a contractor visits an occupied unit.",
      "read_note": "Full text read 2026-11-10.",
      "url": "https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1954"
    },
